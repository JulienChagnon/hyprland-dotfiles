#!/usr/bin/env bash
# waybar-net <iface> <WIFI|ETH> [STYLE]
# Output: "<icon> 1.2M", download rate only, auto-scales B -> K -> M -> G per second.
#
# Every style uses the same Font Awesome wifi/ethernet icons (the PERSONAL ones).
# STYLE (3rd arg, default PERSONAL, case-insensitive) only changes:
#   PERSONAL: rate in warm grey, a down link is shown dimmed as "---"
#   MINIMUM:  rate in white, a down link prints NOTHING, so waybar hides the module
#             (only the connections that are actually up are shown)
#
# Width is locked by the module's "min-length" + "align": 0 in config.jsonc, not by
# padding here. fmt() keeps the rate to at most 6 chars so it always fits.
iface="${1:-wlan0}"
label="${2:-NET}"
style="${3:-PERSONAL}"
style="${style^^}"
state="/tmp/waybar-net-${iface}.state"

# Font Awesome glyphs, forced with a span because the bar font (Noto Sans Mono)
# has no such characters.
case "$label" in
    WIFI) glyph=$'' ;;   # fa-wifi
    ETH)  glyph=$'' ;;   # fa-ethernet
    *)    glyph="" ;;
esac
[[ -n "$glyph" ]] && label="<span font_family='Font Awesome 6 Free' font_weight='900'>$glyph</span>"

value_colour="#B4AEA4"
[[ "$style" == "MINIMUM" ]] && value_colour="#ffffff"

if [[ ! -d "/sys/class/net/$iface" ]] \
   || [[ "$(< /sys/class/net/$iface/operstate)" != "up" ]]; then
    rm -f "$state"   # stale counter would give a bogus first rate on reconnect
    if [[ "$style" == "MINIMUM" ]]; then
        echo ""      # empty text = waybar hides the module
    else
        printf "<span alpha='45%%'>%s ---</span>\n" "$label"
    fi
    exit
fi

rx=$(< "/sys/class/net/$iface/statistics/rx_bytes")
now=$(date +%s%3N)

rxBps=0
if [[ -f "$state" ]]; then
    read -r p_rx p_t < "$state"
    dt=$(( now - p_t ))
    if (( dt > 200 && rx >= p_rx )); then   # rx < p_rx = counter reset, report 0
        rxBps=$(( (rx - p_rx) * 1000 / dt ))
    fi
fi
echo "$rx $now" > "$state"

# Move up a unit (/1024) while the number would print as 1000 or more (>= 999.95
# rounds to "1000.0"), so it never needs more than 3 integer digits: worst case
# "999.9K", 6 chars, which fits inside the module's min-length.
fmt() {
    awk -v b="$1" 'BEGIN {
        split("B K M G", unit, " "); i = 1; v = b
        while (v >= 999.95 && i < 4) { v /= 1024; i++ }
        s = (i == 1) ? sprintf("%dB", v) : sprintf("%.1f%s", v, unit[i])
        printf "%s", s
    }'
}

printf "%s <span foreground='%s'>%s</span>\n" "$label" "$value_colour" "$(fmt "$rxBps")"
